# Copie para .env.compose. Use somente valores URL-safe nos segredos usados em URLs.
CHADARADZIN_ENV_FILE=.env.compose
CHADARADZIN_ENV=development
DJANGO_DEBUG=sim
DJANGO_SECRET_KEY=troque-por-uma-chave-url-safe-longa
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=nao
DJANGO_TRUST_PROXY_HEADERS=nao
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_PORT=8000
POSTGRES_PASSWORD=troque-por-uma-senha-url-safe-longa
CHADARADZIN_IMAGE=chadaradzin
CHADARADZIN_IMAGE_TAG=local

TELEGRAM_OIDC_ENABLED=nao
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
BETA_ACCESS_REQUIRED=nao
TELEGRAM_MANAGER_ENABLED=nao
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_BOT_USERNAME=
TELEGRAM_MANAGER_WEBHOOK_ID=
TELEGRAM_MANAGER_WEBHOOK_SECRET=
BOT_TOKEN_ENCRYPTION_KEYS=
TELEGRAM_FALLBACK_BOT_TOKEN=

STRUCTURED_LOGS=sim
COLLECTION_DAILY_TIME=21:05
COLLECTION_WORKER_POLL_SECONDS=5
COLLECTION_SCHEDULER_POLL_SECONDS=60
OPERATIONAL_MONITOR_INTERVAL_SECONDS=300
TRANSIENT_DATA_RETENTION_DAYS=30
SECURITY_EVENT_RETENTION_DAYS=180
BACKUP_RETENTION_DAYS=30
