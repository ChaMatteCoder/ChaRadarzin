# Copie para .env.staging e substitua todos os marcadores antes do deploy.
CHADARADZIN_ENV_FILE=.env.staging
CHADARADZIN_ENV=staging
DJANGO_DEBUG=nao
DJANGO_SECRET_KEY=SUBSTITUA_POR_SEGREDO_URL_SAFE
DJANGO_ALLOWED_HOSTS=staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
DJANGO_SECURE_SSL_REDIRECT=sim
DJANGO_TRUST_PROXY_HEADERS=sim
PUBLIC_BASE_URL=https://staging.example.com
APP_PORT=8000
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_URL_SAFE
CHADARADZIN_IMAGE=chadaradzin
CHADARADZIN_IMAGE_TAG=staging

TELEGRAM_OIDC_ENABLED=sim
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
BETA_ACCESS_REQUIRED=sim
TELEGRAM_MANAGER_ENABLED=sim
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_BOT_USERNAME=
TELEGRAM_MANAGER_WEBHOOK_ID=
TELEGRAM_MANAGER_WEBHOOK_SECRET=
BOT_TOKEN_ENCRYPTION_KEYS=
TELEGRAM_FALLBACK_BOT_TOKEN=

STRUCTURED_LOGS=sim
COLLECTION_DAILY_TIME=21:05
COLLECTION_WORKER_POLL_SECONDS=5
COLLECTION_SCHEDULER_POLL_SECONDS=60
OPERATIONAL_MONITOR_INTERVAL_SECONDS=300
TRANSIENT_DATA_RETENTION_DAYS=30
SECURITY_EVENT_RETENTION_DAYS=180
BACKUP_RETENTION_DAYS=30
