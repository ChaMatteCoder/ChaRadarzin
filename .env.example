# Copie para .env e use --with-shipping apenas quando quiser consultar o frete.
CEP_ENTREGA=00000000
RADAR_TIMEOUT_SEGUNDOS=20
RADAR_TENTATIVAS=1

# O pagamento continua definido por produto na planilha do MVP.
# Telegram: deixe desativado ate validar a mensagem de teste.
TELEGRAM_NOTIFICACOES=nao
TELEGRAM_ALERTAR_AUMENTO=nao
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fundacao web Django. Em producao, troque o ambiente, gere uma chave longa e
# use uma URL PostgreSQL com credenciais fornecidas pelo ambiente de deploy.
CHADARADZIN_ENV=development
DJANGO_DEBUG=sim
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=nao
DJANGO_TRUST_PROXY_HEADERS=nao
DATABASE_URL=

# Login oficial do Telegram via OpenID Connect. O bot gerenciador da Etapa 3
# tera credenciais separadas destas.
TELEGRAM_OIDC_ENABLED=nao
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
BETA_ACCESS_REQUIRED=nao

# Bot gerenciador e bots pessoais (Etapa 3). Gere o webhook ID como UUID e os
# segredos localmente. BOT_TOKEN_ENCRYPTION_KEYS usa: versao:chave_fernet
PUBLIC_BASE_URL=http://127.0.0.1:8000
TELEGRAM_MANAGER_ENABLED=nao
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_BOT_USERNAME=
TELEGRAM_MANAGER_WEBHOOK_ID=
TELEGRAM_MANAGER_WEBHOOK_SECRET=
BOT_TOKEN_ENCRYPTION_KEYS=
TELEGRAM_FALLBACK_BOT_TOKEN=
TELEGRAM_ONBOARDING_TTL_MINUTES=20
TELEGRAM_MANUAL_REFRESH_COOLDOWN_MINUTES=60
TELEGRAM_API_TIMEOUT_SECONDS=8
TELEGRAM_DELIVERY_LEASE_SECONDS=300
TELEGRAM_WEBHOOK_RATE_LIMIT=120
TELEGRAM_WEBHOOK_RATE_WINDOW_SECONDS=60

# Observabilidade. Logs JSON evitam valores livres; o status operacional agrega
# somente contagens e codigos, sem CEP, URL, chat ID ou token.
STRUCTURED_LOGS=sim
OPERATIONAL_LOOKBACK_HOURS=24
OPERATIONAL_COLLECTION_STALE_HOURS=30
TRANSIENT_DATA_RETENTION_DAYS=30
SECURITY_EVENT_RETENTION_DAYS=180
BACKUP_RETENTION_DAYS=30

# Prévia controlada de links exatos. Não aumente estes limites sem revisar SSRF,
# memória, timeout e capacidade do servidor.
PRODUCT_PREVIEW_TTL_MINUTES=30
PRODUCT_PREVIEW_RATE_LIMIT=8
PRODUCT_PREVIEW_WINDOW_MINUTES=10
PRODUCT_PREVIEW_TIMEOUT_SECONDS=8
PRODUCT_PREVIEW_MAX_BYTES=2097152

# Motor compartilhado: limite por loja e limites defensivos de rede.
COLLECTION_REQUESTS_PER_MINUTE=12
COLLECTION_TIMEOUT_SECONDS=10
COLLECTION_MAX_BYTES=2097152
COLLECTION_SHIPPING_TIMEOUT_SECONDS=8

# Fila e worker da coleta diaria (Etapa 6). O scheduler usa o fuso TIME_ZONE.
COLLECTION_DAILY_TIME=21:05
COLLECTION_JOB_MAX_ATTEMPTS=4
COLLECTION_RETRY_BASE_SECONDS=300
COLLECTION_RETRY_MAX_SECONDS=3600
COLLECTION_JOB_LEASE_SECONDS=7200
COLLECTION_WORKER_POLL_SECONDS=5
COLLECTION_SCHEDULER_POLL_SECONDS=60
OPERATIONAL_MONITOR_INTERVAL_SECONDS=300
